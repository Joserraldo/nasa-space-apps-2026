{
  "name": "solar-shield",
  "private": true,
  "version": "0.1.0",
  "description": "Juego web educativo para NASA Space Apps 2026 (monorepo npm workspaces)",
  "workspaces": [
    "contracts",
    "design",
    "engine",
    "agents",
    "data",
    "missions",
    "ui"
  ],
  "scripts": {
    "typecheck": "tsc -b contracts design engine agents data missions ui infra/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dev": "npm run dev -w ui",
    "build": "npm run build -w ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
