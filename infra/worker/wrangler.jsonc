// Un solo Worker sirve la pantalla (ui/dist) y la API (/api/*).
// Producción: Worker "nasa-space-apps-2026" (rama main). Preview: "nasa-space-apps-2026-preview" (rama develop).
// Las claves NUNCA van aquí: se suben con `npx wrangler secret put <NOMBRE>` (ver infra/worker/README.md).
{
  "name": "nasa-space-apps-2026",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Salida real de `npm run build -w ui` (vite.config.ts: outDir "dist").
    "directory": "../../ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker corre primero: /api/* lo resuelve él y el resto se lo pasa a ASSETS.
    "run_worker_first": true
  },
  "vars": {
    "ENTORNO": "produccion",
    "BAI_BASE_URL": "https://api.b.ai/v1",
    "BAI_MODEL": "qwen3.8-flash"
  },
  "observability": { "enabled": true },
  // Base de datos de producción (usuarios con login y su progreso). Migraciones en ./migrations.
  "d1_databases": [
    { "binding": "DB", "database_name": "solar-shield-prod", "database_id": "3ca64738-11d6-4988-b94a-9962c7807a3a", "migrations_dir": "migrations" }
  ],
  "env": {
    "preview": {
      "name": "nasa-space-apps-2026-preview",
      "vars": {
        "ENTORNO": "preview",
        "BAI_BASE_URL": "https://api.b.ai/v1",
        "BAI_MODEL": "qwen3.8-flash"
      },
      // Base separada: un preview nunca toca usuarios de producción.
      "d1_databases": [
        { "binding": "DB", "database_name": "solar-shield-preview", "database_id": "c08ac513-575e-4c07-a99d-6feb4bc447da", "migrations_dir": "migrations" }
      ]
    }
  }
}
